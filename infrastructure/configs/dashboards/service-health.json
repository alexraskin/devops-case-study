          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ml_api_memory_bytes{namespace=\"ml-api\"}",
          "legendFormat": "{{pod}} reported"
        },
        {
          "refId": "B",
          "expr": "container_memory_working_set_bytes{namespace=\"ml-api\", container=\"ml-api\"}",
          "legendFormat": "{{pod}} working set"
        },
        {
          "refId": "C",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"ml-api\", container=\"ml-api\", resource=\"memory\"})",
          "legendFormat": "limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "/predict requests vs predictions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ml_api_requests_total{endpoint=\"/predict\"}[10m]))",
          "legendFormat": "/predict requests"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ml_api_predictions_total[10m]))",
          "legendFormat": "predictions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "id": 18
    },
    {
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"ml-api\"} != \"/health\" != \"/ready\""
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "id": 8
